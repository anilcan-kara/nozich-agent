{
  "name": "nozich-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web"
  ],
  "scripts": {
    "postinstall": "echo '✅ Browser tools ready. Run: python run_agent.py --help'",
    "lint": "biome check .",
    "typecheck": "bun run --cwd apps/shared typecheck",
    "test": "bun test test/",
    "build": "bun run --cwd ui-tui/packages/nozich-ink build",
    "install:root": "bun install",
    "install:web": "bun install --cwd web",
    "install:tui": "bun install --cwd ui-tui",
    "install:desktop": "bun install --cwd apps/desktop",
    "audit:root": "bun audit",
    "audit:web": "bun audit",
    "audit:tui": "bun audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilcan-kara/Nozich-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anilcan-kara/Nozich-Agent/issues"
  },
  "homepage": "https://github.com/anilcan-kara/Nozich-Agent#readme",
  "dependencies": {
    "@streamdown/math": "^1.0.2",
    "agent-browser": "^0.26.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@assistant-ui/store": "0.2.13",
    "serialize-javascript": "^7.1.3",
    "tinypool": "^2.1.2",
    "katex": "^0.18.10",
    "minimatch": "^11.0.1",
    "postcss-selector-parser": "^6.1.5"
  }
}
