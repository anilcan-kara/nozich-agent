{
  "name": "nozich-tui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build --prefix packages/nozich-ink && tsx --watch src/entry.tsx",
    "start": "tsx src/entry.tsx",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ packages/",
    "lint:fix": "eslint src/ packages/ --fix",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}'",
    "fix": "npm run lint:fix && npm run fmt",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nozich/ink": "file:./packages/nozich-ink",
    "@nanostores/react": "^1.1.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "nanostores": "^1.2.0",
    "react": "19.3.1",
    "undici": "^6.25.0",
    "unicode-animations": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.1",
    "globals": "^16",
    "prettier": "^3",
    "tsx": "^4.22.4",
    "typescript": "7.0.2",
    "vitest": "^4.1.3"
  }
}
